{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "type": "file",
    "padding": {
      "left": 1,
      "top": 0,
      "right": 2
    }
  },
  "display": {
    "separator": " : ",
    "key": {
      "width": 3
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "---------------------"
    },
    {
      "type": "os",
      "key": "󰍹"
    },
    {
      "type": "kernel",
      "key": ""
    },
    {
      "type": "packages",
      "key": ""
    },
    {
      "type": "shell",
      "key": ""
    },
    {
      "type": "wm",
      "key": "󰖲"
    },
    {
      "type": "memory",
      "key": "󰍛"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "block": {
        "range": [1, 7],
        "width": 3
      }
    }
  ]
}
