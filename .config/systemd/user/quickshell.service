[Unit]
Description=Quickshell Desktop Shell Bar & Panels (Omicron Shell)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=QML_IMPORT_PATH=%h/.local/share/hyprsimple/default/quickshell
ExecStart=/usr/bin/qs -p %h/.local/share/hyprsimple/default/quickshell
Restart=always
RestartSec=1
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
