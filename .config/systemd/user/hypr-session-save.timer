[Unit]
Description=Guarda la sesion de Hyprland cada 30 s
Documentation=man:hyprctl(1)

[Timer]
# Cada 30 s en vez de solo al cerrar sesion: si la maquina se apaga de golpe
# o se cuelga, el ultimo estado guardado sigue siendo valido.
OnBootSec=45s
OnUnitActiveSec=30s
AccuracySec=5s
Unit=hypr-session-save.service

[Install]
WantedBy=timers.target
