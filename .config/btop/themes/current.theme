# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#09090b"

# Main text color
theme[main_fg]="#ededed"

# Title color for boxes
theme[title]="#ededed"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e4e4e7"

# Background color of selected item in processes box
theme[selected_bg]="#52525b"

# Foreground color of selected item in processes box
theme[selected_fg]="#e4e4e7"

# Color of inactive/disabled text
theme[inactive_fg]="#52525b"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#ededed"

# Background color of the percentage meters
theme[meter_bg]="#52525b"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#ededed"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#a1a1aa"
theme[mem_box]="#22c55e"
theme[net_box]="#ef4444"
theme[proc_box]="#e4e4e7"

# Box divider line and small boxes line color
theme[div_line]="#52525b"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#22c55e"
theme[temp_mid]="#eab308"
theme[temp_end]="#ef4444"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="#d4d4d8"
theme[cpu_mid]="#71717a"
theme[cpu_end]="#a1a1aa"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#a1a1aa"
theme[free_mid]="#71717a"
theme[free_end]="#d4d4d8"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#71717a"
theme[cached_mid]="#d4d4d8"
theme[cached_end]="#a1a1aa"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#eab308"
theme[available_mid]="#ef4444"
theme[available_end]="#ef4444"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#22c55e"
theme[used_mid]="#d4d4d8"
theme[used_end]="#71717a"

# Download graph colors (Peach -> Red)
theme[download_start]="#eab308"
theme[download_mid]="#ef4444"
theme[download_end]="#ef4444"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#22c55e"
theme[upload_mid]="#d4d4d8"
theme[upload_end]="#71717a"

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Mauve)
theme[process_start]="#d4d4d8"
theme[process_mid]="#71717a"
theme[process_end]="#a1a1aa"
