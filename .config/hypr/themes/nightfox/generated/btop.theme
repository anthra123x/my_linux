# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#192330"

# Main text color
theme[main_fg]="#cdcecf"

# Title color for boxes
theme[title]="#cdcecf"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#719cd6"

# Background color of selected item in processes box
theme[selected_bg]="#575860"

# Foreground color of selected item in processes box
theme[selected_fg]="#719cd6"

# Color of inactive/disabled text
theme[inactive_fg]="#575860"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#cdcecf"

# Background color of the percentage meters
theme[meter_bg]="#575860"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#cdcecf"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#9d79d6"
theme[mem_box]="#81b29a"
theme[net_box]="#c94f6d"
theme[proc_box]="#719cd6"

# Box divider line and small boxes line color
theme[div_line]="#575860"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#81b29a"
theme[temp_mid]="#dbc074"
theme[temp_end]="#c94f6d"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="#63cdcf"
theme[cpu_mid]="#719cd6"
theme[cpu_end]="#9d79d6"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#9d79d6"
theme[free_mid]="#719cd6"
theme[free_end]="#63cdcf"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#719cd6"
theme[cached_mid]="#63cdcf"
theme[cached_end]="#9d79d6"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#dbc074"
theme[available_mid]="#c94f6d"
theme[available_end]="#c94f6d"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#81b29a"
theme[used_mid]="#63cdcf"
theme[used_end]="#719cd6"

# Download graph colors (Peach -> Red)
theme[download_start]="#dbc074"
theme[download_mid]="#c94f6d"
theme[download_end]="#c94f6d"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#81b29a"
theme[upload_mid]="#63cdcf"
theme[upload_end]="#719cd6"

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Mauve)
theme[process_start]="#63cdcf"
theme[process_mid]="#719cd6"
theme[process_end]="#9d79d6"
