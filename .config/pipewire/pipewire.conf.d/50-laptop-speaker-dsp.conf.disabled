# Vivobook Go Laptop Speaker Acoustic Equalization and Bass Enhancement
#
# WirePlumber smart filter targeting the internal laptop speaker:
# alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink
#
# Tuning profile:
# - Sub-bass flutter protection (HPF 65 Hz)
# - Tactile bass punch and body (135 Hz +5.5 dB)
# - Equal-loudness warmth at low listening volumes (220 Hz +3.5 dB)
# - Anti-boxiness chassis resonance reduction (480 Hz -3.0 dB)
# - Vocal clarity and dialogue presence (2000 Hz +1.5 dB)
# - Anti-sibilance / harsh treble smoothing (7000 Hz -2.5 dB)
# - Hi-Fi air and open sparkle extension (11000 Hz +2.5 dB)
# - Preamp headroom attenuation (-4.0 dB) to ensure zero digital clipping

context.modules = [
    { name = libpipewire-module-filter-chain
        args = {
            node.description = "Laptop Speaker Acoustic DSP"
            media.name       = "Laptop Speaker Acoustic DSP"
            filter.graph = {
                nodes = [
                    {
                        type  = builtin
                        name  = preamp
                        label = linear
                        control = { "Mult" = 0.631 "Add" = 0.0 }
                    }
                    {
                        type  = builtin
                        name  = eq_hpf
                        label = bq_highpass
                        control = { "Freq" = 65.0 "Q" = 0.707 "Gain" = 0.0 }
                    }
                    {
                        type  = builtin
                        name  = eq_bass_punch
                        label = bq_peaking
                        control = { "Freq" = 135.0 "Q" = 1.3 "Gain" = 5.5 }
                    }
                    {
                        type  = builtin
                        name  = eq_bass_warmth
                        label = bq_peaking
                        control = { "Freq" = 220.0 "Q" = 1.4 "Gain" = 3.5 }
                    }
                    {
                        type  = builtin
                        name  = eq_debox
                        label = bq_peaking
                        control = { "Freq" = 480.0 "Q" = 1.5 "Gain" = -3.0 }
                    }
                    {
                        type  = builtin
                        name  = eq_vocal
                        label = bq_peaking
                        control = { "Freq" = 2000.0 "Q" = 1.2 "Gain" = 1.5 }
                    }
                    {
                        type  = builtin
                        name  = eq_deharsh
                        label = bq_peaking
                        control = { "Freq" = 7000.0 "Q" = 2.0 "Gain" = -2.5 }
                    }
                    {
                        type  = builtin
                        name  = eq_air
                        label = bq_highshelf
                        control = { "Freq" = 11000.0 "Q" = 0.707 "Gain" = 2.5 }
                    }
                ]
                links = [
                    { output = "preamp:Out" input = "eq_hpf:In" }
                    { output = "eq_hpf:Out" input = "eq_bass_punch:In" }
                    { output = "eq_bass_punch:Out" input = "eq_bass_warmth:In" }
                    { output = "eq_bass_warmth:Out" input = "eq_debox:In" }
                    { output = "eq_debox:Out" input = "eq_vocal:In" }
                    { output = "eq_vocal:Out" input = "eq_deharsh:In" }
                    { output = "eq_deharsh:Out" input = "eq_air:In" }
                ]
            }
            audio.channels = 2
            audio.position = [ FL FR ]
            capture.props = {
                node.name         = "effect_input.laptop_speaker_dsp"
                node.description  = "Laptop Speaker DSP Input"
                media.class       = Audio/Sink
                filter.smart      = true
                filter.smart.name = "laptop_speaker_dsp"
                filter.smart.target = "{ \"node.name\": \"alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink\" }"
            }
            playback.props = {
                node.name         = "effect_output.laptop_speaker_dsp"
                node.description  = "Laptop Speaker DSP Output"
                node.passive      = true
                filter.smart      = true
                filter.smart.name = "laptop_speaker_dsp"
                filter.smart.target = "{ \"node.name\": \"alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink\" }"
                target.object     = "alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink"
            }
        }
    }
]

