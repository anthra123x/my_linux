class GalleryHandler(BaseHTTPRequestHandler):
    server_version = "wallmotion"

    def log_message(self, *_args):  # silencia el log del servidor
        pass

    # ── utilidades ──
    def _send(self, code, body=b"", ctype="text/plain; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _json(self, data, code=200):
        self._send(code, json.dumps(data, ensure_ascii=False).encode(),
                   "application/json; charset=utf-8")

    def _body(self) -> dict:
        try:
            n = int(self.headers.get("Content-Length") or 0)
            return json.loads(self.rfile.read(n) or b"{}") if n else {}
        except (ValueError, OSError):
            return {}

    def _resolve(self, key: str) -> Path | None:
        """Resuelve un id de la biblioteca a ruta real (anti path traversal)."""
        item = find_item(key)
        if not item:
            return None
        path = Path(item["path"]).resolve()
        if not path.exists() or LIB.resolve() not in path.parents:
            return None
        return path

    # ── GET ──
    def do_GET(self):
        route = self.path.split("?")[0]

        if route in ("/", "/index.html"):
            return self._send(200, GALLERY_HTML.encode(), "text/html; charset=utf-8")

        if route == "/api/library":
            return self._json({"items": library()})

        if route == "/api/state":
            return self._json(status())

        if route.startswith("/file/"):
            path = self._resolve(unquote(route[6:]))
            if not path:
                return self._send(404, b"no encontrado")
            ctype = mimetypes.guess_type(path.name)[0] or "video/mp4"
            with path.open("rb") as fh:
                data = fh.read()
            return self._send(200, data, ctype)

        if route.startswith("/thumb/"):
            name = unquote(route[7:]).removesuffix(".jpg")
            thumb = (THUMBS / f"{name}.jpg").resolve()
            if not thumb.exists() or THUMBS.resolve() not in thumb.parents:
                return self._send(404, b"no encontrado")
            return self._send(200, thumb.read_bytes(), "image/jpeg")

        self._send(404, b"ruta desconocida")

    # ── POST ──
    def do_POST(self):
        route = self.path.split("?")[0]
        body = self._body()

        if route == "/api/apply":
            ident = str(body.get("id") or "")
            if not find_item(ident):
                return self._json({"ok": False, "error": "fondo no encontrado"})
            try:
                play(ident)
            except SystemExit:
                return self._json({"ok": False, "error": "no se pudo reproducir"})
            return self._json({"ok": True})

        if route == "/api/command":
            action = str(body.get("action") or "")
            try:
                if action in ("next", "prev", "random"):
                    step(action)
                elif action == "stop":
                    stop()
                elif action == "toggle":
                    pause_resume("resume" if status()["paused"] else "pause")
                elif action == "pause":
                    pause_resume("pause")
                elif action == "resume":
                    pause_resume("resume")
                else:
                    return self._json({"ok": False, "error": f"acción '{action}' desconocida"})
            except SystemExit as exc:
                return self._json({"ok": False, "error": str(exc)})
            return self._json({"ok": True})

        self._json({"ok": False, "error": "ruta desconocida"}, 404)


def cmd_gallery(args) -> None:
    port = args.port or 7373
    if not library():
        print("! Tu galería está vacía. Añade fondos con:")
        print("    wallmotion curate           (colección gratis)")
        print("    wallmotion add ~/Videos/*.mp4")
    srv = ThreadingHTTPServer(("127.0.0.1", port), GalleryHandler)
    url = f"http://127.0.0.1:{port}/"
    print(f"🖼  Galería en {url}   (Ctrl+C para cerrar)")
    try:
        if shutil.which("xdg-open"):
            subprocess.Popen(["xdg-open", url], start_new_session=True)
    except OSError:
        pass
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nGalería cerrada.")
        srv.shutdown()


# ─────────────────────────────────────────────────────────────────────────────
# Instalación
# ─────────────────────────────────────────────────────────────────────────────

def cmd_setup(_args) -> None:
    installer = SELF.with_name("wallmotion-install")
    print("═" * 62)
    print("  wallmotion · estado de la instalación")
    print("═" * 62)

    missing = [b for b in ("ffmpeg", "ffprobe") if not have(b)]
    if missing:
        print(f"✗ Falta en el sistema: {', '.join(missing)}")
    else:
        print("✓ ffmpeg y ffprobe presentes  (miniaturas y análisis de vídeo)")

    if engine_installed():
        print("✓ mpvpaper instalado  (motor de reproducción)")
    else:
        print("✗ mpvpaper NO instalado  (falta el motor de vídeo)")
        print()
        print("  Ejecuta esto y escribe tu contraseña cuando la pida:")
        print(f"    bash {installer}")
        print()
        print("  Instalará mpv + mpvpaper. No necesita ningún helper AUR.")
        return

    autostart("enable")
    idle("enable")
    state = read_json(STATE, {})
    print()
    print(f"✓ Biblioteca: {len(library())} fondos")
    if state.get("current"):
        print("→ Restaura tu último fondo con:  wallmotion restore")
    print("→ Abre la galería con:           wallmotion gallery")


# ─────────────────────────────────────────────────────────────────────────────
# CLI
# ─────────────────────────────────────────────────────────────────────────────

def cmd_add(args) -> None:
    targets = []
    for raw in args.targets:
        path = Path(os.path.expanduser(raw))
        if path.is_dir():
            targets += sorted(p for p in path.iterdir() if p.suffix.lower() in VIDEO_EXT)
        elif path.is_file():
            targets.append(path)
        elif raw.startswith(("http://", "https://")):
            targets.append(raw)
        else:
            print(f"✗ No encuentro: {raw}", file=sys.stderr)

    if not targets:
        die("Nada que importar.")

    ok = 0
    for t in targets:
        item, is_new = (import_url(str(t), tags=args.tags) if isinstance(t, str)
                        else import_file(t, tags=args.tags))
        if not item:
            print(f"✗ Falló: {t}", file=sys.stderr)
            continue
        if not is_new:
            print(f"· {item['title']} ya estaba en la galería")
            continue
        ok += 1
        print(f"✓ {item['title']}  ({item['width']}×{item['height']}, "
              f"{fmt_duration(item['duration'])}, {fmt_size(item['size'])})")
    print(f"\n{ok} añadidos.  Ábrelos con:  wallmotion gallery")


def cmd_list(args) -> None:
    items = library()
    if not items:
        print("Biblioteca vacía →  wallmotion curate   o   wallmotion add <archivo>")
        return
    state = read_json(STATE, {})
    cur = state.get("current", "")
    print(f"\n{'#':>3}  {'TÍTULO':<38} {'RESOLUCIÓN':<11} {'DUR':<6} {'TAMAÑO':<9} CODEC")
    print("─" * 96)
    for i, it in enumerate(items):
        mark = "▶" if it["id"] == cur else " "
        res = f"{it['width']}x{it['height']}"
        print(f"{mark}{i:>3}  {it['title'][:38]:<38} {res:<11} "
              f"{fmt_duration(it['duration']):<6} {fmt_size(it['size']):<9} {it['vcodec'] or '?'}")
    print(f"\n{len(items)} fondos.")


def cmd_rm(args) -> None:
    items = library()
    item = find_item(args.ref)
    if not item:
        die(f"No encuentro '{args.ref}'")
    Path(item["path"]).unlink(missing_ok=True)
    if item.get("thumb"):
        Path(item["thumb"]).unlink(missing_ok=True)
    save_library([i for i in items if i["id"] != item["id"]])
    print(f"✓ Eliminado: {item['title']}")


def cmd_search(args) -> None:
    items = library()
    q = args.query.lower()
    hits = [i for i in items if q in (i["title"] + " " + " ".join(i.get("tags", []))).lower()]
    if not hits:
        print("Sin resultados.")
        return
    for it in hits:
        print(f"{it['id']:<28} {it['title']}")
    print(f"\nAplica con:  wallmotion play <id>")


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="wallmotion",
        description="Fondos animados para Hyprland · motor mpvpaper + galería web local",
    )
    sub = parser.add_subparsers(dest="cmd")

    p = sub.add_parser("play", help="aplica un fondo (id, archivo o url)")
    p.add_argument("target", nargs="?", help="id de la galería, ruta o URL")

    sub.add_parser("pause", help="pausa la reproducción")
    sub.add_parser("resume", help="reanuda la reproducción")
    sub.add_parser("stop", help="detiene el fondo")
    sub.add_parser("status", help="estado actual + CPU real")
    sub.add_parser("next", help="siguiente fondo")
    sub.add_parser("prev", help="fondo anterior")
    sub.add_parser("random", help="fondo al azar")
    sub.add_parser("restore", help="reexecuta el último fondo (arranque)")

    p = sub.add_parser("add", help="importa vídeos")
    p.add_argument("targets", nargs="+")
    p.add_argument("--tags", default="")

    p = sub.add_parser("curate", help="descarga una colección gratis (Mixkit + Wikimedia)")
    p.add_argument("-n", "--count", type=int, default=12)
    p.add_argument("-q", "--query", default="")

    p = sub.add_parser("gallery", help="abre la galería web")
    p.add_argument("--port", type=int)

    p = sub.add_parser("rm", help="elimina un fondo")
    p.add_argument("ref")

    p = sub.add_parser("search", help="busca en la biblioteca")
    p.add_argument("query")

    p = sub.add_parser("list", help="lista la biblioteca")
    p.set_defaults(func=lambda a: cmd_list(a))

    p = sub.add_parser("autostart", help="enable | disable | status")
    p.add_argument("action", nargs="?", default="status",
                   choices=["enable", "disable", "status"])

    p = sub.add_parser("idle", help="pausa el fondo al bloquear la pantalla")
    p.add_argument("action", nargs="?", default="status",
                   choices=["enable", "disable", "status"])

    sub.add_parser("setup", help="comprueba e instala")

    args = parser.parse_args()
    table = {
        "play": lambda: play(args.target),
        "pause": lambda: pause_resume("pause"),
        "resume": lambda: pause_resume("resume"),
        "stop": lambda: stop(),
        "status": lambda: cmd_status(args),
        "next": lambda: step("next"),
        "prev": lambda: step("prev"),
        "random": lambda: step("random"),
        "restore": restore,
        "add": lambda: cmd_add(args),
        "curate": lambda: curate(args.count, args.query),
        "gallery": lambda: cmd_gallery(args),
        "list": lambda: cmd_list(args),
        "rm": lambda: cmd_rm(args),
        "search": lambda: cmd_search(args),
        "autostart": lambda: autostart(args.action),
        "idle": lambda: idle(args.action),
        "setup": lambda: cmd_setup(args),
    }
    if args.cmd in table:
        table[args.cmd]()


if __name__ == "__main__":
    for d in (CFG, LIB, THUMBS, RUN):
        d.mkdir(parents=True, exist_ok=True)
    main()